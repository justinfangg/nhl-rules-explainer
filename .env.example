# Copy to .env and adjust. All settings can also be set as plain environment variables.

# Postgres (docker compose reads these too)
POSTGRES_USER=nhl
POSTGRES_PASSWORD=nhl
POSTGRES_DB=nhl_rules
POSTGRES_PORT=5433
DATABASE_URL=postgresql://nhl:nhl@localhost:5433/nhl_rules

# Where the CLI finds the API
NHL_API_URL=http://localhost:8000

# Rulebook season the API answers from, and the local embedding model
RULEBOOK_SEASON=2026-27
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Claude model for the Understand and Generate stages
LLM_MODEL=claude-opus-5-5
# UNDERSTAND_EFFORT=low
# GENERATE_EFFORT=medium
# Faithfulness judge (evals only)
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_EFFORT=medium
ANTHROPIC_API_KEY=
# Only if your API key isn't scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=
