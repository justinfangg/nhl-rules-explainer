# Copy to .env and adjust. All settings can also be set as plain environment variables.

# Postgres (docker compose reads these too)
POSTGRES_USER=nhl
POSTGRES_PASSWORD=nhl
POSTGRES_DB=nhl_rules
POSTGRES_PORT=5433
DATABASE_URL=postgresql://nhl:nhl@localhost:5433/nhl_rules

# Where the CLI finds the API
NHL_API_URL=http://localhost:8000
